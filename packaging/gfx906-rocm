#!/usr/bin/env bash
# gfx906-rocm — instala, atualiza e faz rollback de builds comunitários do ROCm
# para MI50 / MI60 / Radeon VII (gfx906) no CachyOS / Arch, sem mexer no ROCm do sistema.
#
# Cada versão fica lado a lado em $ROCM_BASE/<nome>; "current" aponta para a ativa
# e "previous" para a anterior. Nada é colocado no PATH global: use `env` ou `exec`.
set -euo pipefail

CONF=${GFX906_ROCM_CONF:-/etc/gfx906-rocm.conf}
# Valores padrão (sobrescreva em $CONF)
ROCM_BASE=/opt/rocm-gfx906
INDEX_URL="https://rocm.nightlies.amd.com/tarball/"
FILTER="gfx906"
KEEP=3
IMAGE="docker.io/mixa3607/rocm-gfx906:10.1-complete"
ENGINE=""
# Pilha de computação: auto | gfx906 | rocm | cuda | vulkan
#   gfx906 = MI50 com ROCm da comunidade; rocm = placas com ROCm oficial (RX 6000/7000/9000...);
#   cuda = NVIDIA; vulkan = GPUs sem ROCm (BC-250, BC-160, Intel): llama.cpp via Vulkan.
GPU_STACK="auto"
# Laboratório (gfx906-rocm lab): imagem própria construída sobre o PyTorch gfx906.
LAB_BASE_REPO="docker.io/mixa3607/pytorch-gfx906"
LAB_BASE=""            # vazio = a tag mais nova do LAB_BASE_REPO (vX.Y.Z-rocm-A.B)
LAB_IMAGE="localhost/gfx906-lab"
LAB_NAME="gfx906-lab"
LAB_DIR="$HOME/lab"    # pasta do host que vira /workspace
LAB_BIND="127.0.0.1"   # 0.0.0.0 para acessar de outro computador da rede
LAB_PORT_JUPYTER=8888
LAB_PORT_CODE=8443
LAB_PORT_SSH=2222
LAB_PYCHARM=0          # 1 = instala o PyCharm dentro da imagem
LAB_SRC="/usr/local/share/numapilot/container"
# Servidor de IA (gfx906-rocm llm): llama.cpp compilado para gfx906, API compatível com OpenAI.
LLM_IMAGE_REPO="docker.io/mixa3607/llama.cpp-gfx906"
LLM_IMAGE=""           # vazio = a build diária mais nova
LLM_ROCM="10.1"        # ROCm preferido nas tags (…-rocm-10.1)
LLM_NAME="gfx906-llm"
LLM_MODELS="$HOME/models"
LLM_MODEL=""           # arquivo .gguf dentro de LLM_MODELS
LLM_GPU="compute:all"  # GPUs (sintaxe do numapilot): compute:all | gfx906-0 | gfx906-1
LLM_CTX=16384
LLM_PORT=8080
LLM_BIND="127.0.0.1"
LLM_ARGS=""            # argumentos extras do llama-server
UPDATE_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/gfx906-lab/updates.log"
# Atualização: "auto" = instala sozinho o que passar na validação; "aviso" = só avisa que há versão nova.
UPDATE_MODE="auto"
REGRESS_PCT=10         # recusa a versão nova se ficar mais lenta que isto (%) em relação à atual
LLM_BENCH_MODEL=""     # .gguf usado para medir o llama.cpp; vazio = o menor da pasta de modelos
# shellcheck source=/dev/null
[[ -r $CONF ]] && source "$CONF"
# Ajustes do usuário feitos pela interface gráfica (sobrepõem o /etc).
USER_SETTINGS="${XDG_CONFIG_HOME:-$HOME/.config}/gfx906-lab/settings.env"
# shellcheck source=/dev/null
[[ -r $USER_SETTINGS ]] && source "$USER_SETTINGS"
ROCM_BASE=${GFX906_ROCM_BASE:-$ROCM_BASE}

# ---------------------------------------------------------------- pilha por arquitetura
kfd_targets() { # gfx_target_version de cada GPU no KFD (ex.: 90006, 120000)
    local p
    for p in /sys/class/kfd/kfd/topology/nodes/*/properties; do
        [[ -r $p ]] && awk '/gfx_target_version/{ if ($2 > 0) print $2 }' "$p"
    done
    return 0
}

detect_stack() {
    local t
    t=$(kfd_targets | sort -u | tr '\n' ' ')
    if [[ " $t " == *" 90006 "* ]]; then echo gfx906; return; fi
    # alvos com ROCm oficial: gfx908/90a/94x, RDNA2 (gfx1030), RDNA3 (gfx110x/115x), RDNA4 (gfx120x)
    if [[ $t =~ (^| )(90008|90010|9040[0-9]|9050[0-9]|100300|1100[0-3][0-9]|1105[0-9][0-9]|1200[0-9][0-9])( |$) ]]; then echo rocm; return; fi
    if command -v nvidia-smi >/dev/null && nvidia-smi -L >/dev/null 2>&1; then echo cuda; return; fi
    echo vulkan
}

[[ $GPU_STACK == auto ]] && GPU_STACK=$(detect_stack)
# Imagens padrão de cada pilha (só se o usuário não escolheu outras no config).
if [[ $GPU_STACK != gfx906 ]]; then
    # tarballs nativos do TheRock: família da placa (ex.: gfx120X-all)
    if [[ $FILTER == gfx906 ]]; then
        case " $(kfd_targets | tr '\n' ' ') " in
            *" 1200"*) FILTER="gfx120X" ;;
            *" 1100"* | *" 1101"*) FILTER="gfx110X" ;;
            *" 1150"*) FILTER="gfx1151" ;;
            *" 100300 "*) FILTER="gfx103X" ;;
        esac
    fi
    [[ $LAB_BASE_REPO == docker.io/mixa3607/pytorch-gfx906 ]] && case $GPU_STACK in
        rocm) LAB_BASE_REPO="docker.io/rocm/pytorch" ;;
        *) LAB_BASE_REPO="docker.io/pytorch/pytorch" ;;
    esac
    [[ $LLM_IMAGE_REPO == docker.io/mixa3607/llama.cpp-gfx906 ]] && LLM_IMAGE_REPO="ghcr.io/ggml-org/llama.cpp"
    # sem placas "de computação" (Instinct): usa a placa de vídeo principal
    [[ $LLM_GPU == compute:all ]] && LLM_GPU="display"
    [[ $IMAGE == docker.io/mixa3607/rocm-gfx906:* ]] && IMAGE="docker.io/rocm/dev-ubuntu-24.04:latest"
fi
llm_moving_tag() { # pilhas fora da gfx906 usam as imagens oficiais do llama.cpp (tag que anda)
    case $GPU_STACK in
        rocm) echo full-rocm ;;
        cuda) echo full-cuda ;;
        *) echo full-vulkan ;;
    esac
}
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/gfx906-rocm

die() { echo "gfx906-rocm: erro: $*" >&2; exit 1; }
info() { echo "==> $*" >&2; }
need_write() {
    mkdir -p "$ROCM_BASE" 2>/dev/null || true
    [[ -w $ROCM_BASE ]] || die "sem permissão em $ROCM_BASE (use sudo, ou GFX906_ROCM_BASE=~/rocm-gfx906)"
}
resolve() { # nome|current|previous -> caminho
    local n=${1:-current}
    local p="$ROCM_BASE/$n"
    [[ -e $p ]] || die "versão '$n' não encontrada (veja: gfx906-rocm list)"
    readlink -f "$p"
}

usage() {
    cat <<EOF
Uso: gfx906-rocm <comando> [args]

  list                         versões instaladas (* = ativa)
  install <url|arquivo> [nome] baixa/extrai um tarball do ROCm lado a lado (não ativa)
  use <nome>                   ativa uma versão (a atual vira "previous")
  rollback                     volta para a versão anterior
  test [nome]                  verifica se a versão enxerga e executa nas gfx906
  update [--check]             procura o tarball mais novo em INDEX_URL (filtro: $FILTER),
                               instala, testa e só ativa se o teste passar
  prune [N]                    mantém só as N versões mais novas (padrão $KEEP) + ativa/anterior
  remove <nome>                apaga uma versão
  env [nome]                   imprime os exports:  eval "\$(gfx906-rocm env)"
  exec [-r nome] -- cmd ...    roda um programa com esse ROCm (sem afetar o sistema)
  container pull [imagem]      baixa/atualiza a imagem ($IMAGE)
  container run [-i imagem] -- cmd ...
                               roda no container com /dev/kfd e só as GPUs escolhidas
                               pelo numapilot (NUMAPILOT_RENDER / NUMAPILOT_CPUS)
  lab [comando]                laboratório de ciência de dados/ML nas MI50 (Jupyter, VS Code, PyCharm):
                                 up | down | info | shell | logs | test | build
                                 update [--check|--force] (testa nas GPUs e volta se falhar) | rollback | pycharm
  llm [comando]                servidor de IA (llama.cpp nas MI50, API compatível com OpenAI):
                                 models | up [modelo.gguf] | down | info | logs | update [--check]
                                 tune [modelo.gguf]: testa as combinações (1 ou todas as GPUs,
                                 divisão por camadas/linhas, flash attention, cache q8_0) e grava
                                 a mais rápida em tokens/s; o "up" passa a usar
  check                        procura versões novas sem mudar nada
  validate [lab|llm|image]     valida as versões em uso nas GPUs e grava como referência
  update-all                   atualiza o que tiver versão nova: cada uma é validada ANTES de trocar
                               (resultado certo nas GPUs, memória, cópia entre placas e desempenho
                               no máximo $REGRESS_PCT% abaixo da atual); se falhar, fica a atual
  hold|unhold lab|llm|image|rocm  trava/destrava um componente na versão atual
  history                      histórico das atualizações com o desempenho de cada versão
  autoupdate enable|disable|status
                               verificação semanal (UPDATE_MODE=auto instala, aviso só avisa)
  doctor                       checa driver, permissões, GPUs e conflitos

Base: $ROCM_BASE   Config: $CONF
EOF
}

find_root() { # acha a raiz do ROCm dentro de um diretório extraído
    local d=$1 hit
    hit=$(find "$d" -maxdepth 4 \( -name 'libamdhip64.so*' -o -name 'rocminfo' \) -print -quit 2>/dev/null || true)
    [[ -n $hit ]] || return 1
    hit=$(dirname "$hit") # .../lib ou .../bin
    dirname "$hit"
}

cmd_list() {
    local cur prev
    cur=$(readlink "$ROCM_BASE/current" 2>/dev/null || true)
    prev=$(readlink "$ROCM_BASE/previous" 2>/dev/null || true)
    shopt -s nullglob
    local any=0
    for d in "$ROCM_BASE"/*/; do
        local n
        n=$(basename "$d")
        [[ $n == current || $n == previous ]] && continue
        any=1
        local mark="  "
        [[ $n == "$cur" ]] && mark="* "
        [[ $n == "$prev" ]] && mark="< "
        printf '%s%-60s %s\n' "$mark" "$n" "$(du -sh "$d" 2>/dev/null | cut -f1)"
    done
    [[ $any == 1 ]] || echo "(nenhuma versão em $ROCM_BASE)"
}

cmd_install() {
    local src=${1:-} name=${2:-}
    [[ -n $src ]] || die "informe a URL ou o arquivo .tar.gz/.tar.xz"
    need_write
    mkdir -p "$CACHE"
    local file
    if [[ $src =~ ^https?:// ]]; then
        file="$CACHE/$(basename "${src%%\?*}")"
        if [[ ! -s $file ]]; then
            info "baixando $src"
            curl -fL --progress-bar --retry 3 -o "$file.part" "$src"
            mv "$file.part" "$file"
        fi
        # Confere o checksum se o servidor publicar um .sha256 ao lado.
        if curl -fsSL "$src.sha256" -o "$file.sha256" 2>/dev/null; then
            info "conferindo sha256"
            (cd "$(dirname "$file")" && sha256sum -c <(awk -v f="$(basename "$file")" '{print $1"  "f}' "$file.sha256")) \
                || die "checksum não confere; apague $file e tente de novo"
        fi
    else
        file=$(readlink -f "$src")
        [[ -f $file ]] || die "arquivo não encontrado: $src"
    fi
    [[ -n $name ]] || name=$(basename "$file" | sed -E 's/\.tar\.(gz|xz|zst)$//; s/\.tgz$//')
    local dest="$ROCM_BASE/$name"
    [[ -e $dest ]] && die "'$name' já está instalada (remova antes ou dê outro nome)"
    local tmp
    tmp=$(mktemp -d "$ROCM_BASE/.extract.XXXXXX")
    trap 'rm -rf "$tmp"' EXIT
    info "extraindo para $dest"
    tar -xf "$file" -C "$tmp"
    local root
    root=$(find_root "$tmp") || die "não parece um tarball do ROCm (não achei libamdhip64.so nem rocminfo)"
    mv "$root" "$dest"
    rm -rf "$tmp"
    trap - EXIT
    info "instalado: $name"
    echo "$name"
}

cmd_use() {
    local n=${1:-}
    [[ -n $n ]] || die "informe o nome (veja: gfx906-rocm list)"
    [[ -d $ROCM_BASE/$n ]] || die "versão '$n' não existe"
    need_write
    local cur
    cur=$(readlink "$ROCM_BASE/current" 2>/dev/null || true)
    if [[ -n $cur && $cur != "$n" ]]; then
        ln -sfn "$cur" "$ROCM_BASE/previous"
    fi
    ln -sfn "$n" "$ROCM_BASE/current"
    info "ativa: $n${cur:+ (anterior: $cur)}"
}

cmd_rollback() {
    local prev
    prev=$(readlink "$ROCM_BASE/previous" 2>/dev/null || true)
    [[ -n $prev ]] || die "não há versão anterior registrada"
    cmd_use "$prev"
}

print_env() {
    local r=$1
    cat <<EOF
export ROCM_PATH="$r"
export HIP_PATH="$r"
export PATH="$r/bin:$r/lib/llvm/bin:\${PATH}"
export LD_LIBRARY_PATH="$r/lib:$r/lib/llvm/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
EOF
}

cmd_env() { print_env "$(resolve "${1:-current}")"; }

cmd_exec() {
    local n=current
    if [[ ${1:-} == -r || ${1:-} == --rocm ]]; then n=$2; shift 2; fi
    [[ ${1:-} == -- ]] && shift
    [[ $# -gt 0 ]] || die "uso: gfx906-rocm exec [-r nome] -- programa args"
    local r
    r=$(resolve "$n")
    eval "$(print_env "$r")"
    exec "$@"
}

cmd_test() {
    local r
    r=$(resolve "${1:-current}")
    eval "$(print_env "$r")"
    local ok=1
    info "testando $r"
    # Testa só as gfx906 (a RX470/gfx803 não é suportada por ROCm recente).
    if [[ -z ${ROCR_VISIBLE_DEVICES:-} ]] && command -v numapilot >/dev/null; then
        local ids
        ids=$(numapilot rocr-ids 2>/dev/null || true)
        [[ -n $ids ]] && export ROCR_VISIBLE_DEVICES=$ids
    fi
    if [[ -x $r/bin/rocminfo ]]; then
        local agents
        agents=$("$r/bin/rocminfo" 2>/dev/null | grep -oE 'gfx906[^ ]*' | sort | uniq -c || true)
        if [[ -n $agents ]]; then
            echo "rocminfo enxerga: $agents"
        else
            echo "FALHOU: rocminfo não listou nenhuma gfx906"; ok=0
        fi
    else
        echo "aviso: rocminfo não está nesta versão"
    fi
    local hipcc=""
    [[ -x $r/bin/hipcc ]] && hipcc=$r/bin/hipcc
    [[ -z $hipcc && -x $r/lib/llvm/bin/clang++ ]] && hipcc="$r/lib/llvm/bin/clang++ -x hip"
    if [[ -n $hipcc ]]; then
        local t
        t=$(mktemp -d)
        cat >"$t/t.hip" <<'EOF'
#include <hip/hip_runtime.h>
#include <cstdio>
__global__ void k(float* a){ int i=threadIdx.x; a[i]=i*2.0f; }
int main(){
  int n=0; if(hipGetDeviceCount(&n)!=hipSuccess||n==0){printf("nenhuma GPU HIP\n");return 1;}
  int bad=0;
  for(int d=0; d<n; d++){
    hipDeviceProp_t p; hipGetDeviceProperties(&p,d); hipSetDevice(d);
    float *g,h[64]; hipMalloc(&g,sizeof h); hipLaunchKernelGGL(k,1,64,0,0,g);
    hipMemcpy(h,g,sizeof h,hipMemcpyDeviceToHost); hipFree(g);
    int ok=1; for(int i=0;i<64;i++) if(h[i]!=i*2.0f) ok=0;
    printf("GPU %d %s (%s): %s\n",d,p.name,p.gcnArchName,ok?"OK":"ERRO"); bad+=!ok;
  }
  return bad;
}
EOF
        # shellcheck disable=SC2086
        if $hipcc --offload-arch=gfx906 -O1 "$t/t.hip" -o "$t/t" -L"$r/lib" -lamdhip64 2>"$t/err"; then
            "$t/t" || ok=0
        else
            echo "FALHOU: compilação HIP para gfx906"; sed -n 1,10p "$t/err"; ok=0
        fi
        rm -rf "$t"
    else
        echo "aviso: sem hipcc nesta versão; só o rocminfo foi testado"
    fi
    [[ $ok == 1 ]] && { info "teste OK"; return 0; }
    info "teste FALHOU"; return 1
}

latest_remote() {
    curl -fsSL "$INDEX_URL" \
        | grep -oE 'href="[^"]+\.tar\.(gz|xz)"' \
        | sed -E 's/^href="//; s/"$//' \
        | grep -E "$FILTER" \
        | sort -V | tail -n1
}

cmd_update() {
    local check=0
    [[ ${1:-} == --check ]] && check=1
    info "procurando em $INDEX_URL (filtro: $FILTER)"
    local f
    f=$(latest_remote) || true
    [[ -n $f ]] || die "nada encontrado; ajuste INDEX_URL/FILTER em $CONF ou use: gfx906-rocm install <url>"
    local url
    if [[ $f =~ ^https?:// ]]; then url=$f; else url="${INDEX_URL%/}/${f#/}"; fi
    local name
    name=$(basename "$f" | sed -E 's/\.tar\.(gz|xz)$//')
    local cur
    cur=$(readlink "$ROCM_BASE/current" 2>/dev/null || true)
    if [[ $name == "$cur" ]]; then
        info "já está na mais nova: $name"; return 0
    fi
    echo "disponível: $name  (ativa: ${cur:-nenhuma})"
    [[ $check == 1 ]] && return 0
    [[ -d $ROCM_BASE/$name ]] || cmd_install "$url" "$name" >/dev/null
    if cmd_test "$name"; then
        cmd_use "$name"
        cmd_prune "$KEEP"
    else
        info "a nova versão não passou no teste: continua ativa ${cur:-nenhuma}. Ela fica instalada para você investigar."
        return 1
    fi
}

cmd_prune() {
    local keep=${1:-$KEEP}
    need_write
    local cur prev
    cur=$(readlink "$ROCM_BASE/current" 2>/dev/null || true)
    prev=$(readlink "$ROCM_BASE/previous" 2>/dev/null || true)
    local all=()
    while IFS= read -r d; do all+=("$d"); done < <(
        find "$ROCM_BASE" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%T@ %f\n' | sort -rn | cut -d' ' -f2-)
    local i=0
    for n in "${all[@]}"; do
        i=$((i + 1))
        [[ $n == "$cur" || $n == "$prev" ]] && continue
        if (( i > keep )); then info "removendo $n"; rm -rf "${ROCM_BASE:?}/$n"; fi
    done
}

cmd_remove() {
    local n=${1:-}
    [[ -n $n && -d $ROCM_BASE/$n ]] || die "versão '$n' não existe"
    [[ $(readlink "$ROCM_BASE/current" 2>/dev/null) == "$n" ]] && die "'$n' está ativa; ative outra antes"
    need_write
    rm -rf "${ROCM_BASE:?}/$n"
    info "removida: $n"
}

host_gid_args() { # --group-add com os GIDs do host (os nomes podem ter outro GID no container)
    local g gid
    for g in video render; do
        gid=$(getent group "$g" | cut -d: -f3)
        [[ -n $gid ]] && printf -- '--group-add\n%s\n' "$gid"
    done
    return 0
}

engine() {
    if [[ -n $ENGINE ]]; then echo "$ENGINE"; return; fi
    command -v podman >/dev/null && { echo podman; return; }
    command -v docker >/dev/null && { echo docker; return; }
    die "instale podman ou docker (sudo pacman -S podman)"
}

cmd_container() {
    local sub=${1:-}; shift || true
    local eng
    eng=$(engine)
    case $sub in
    pull) "$eng" pull "${1:-$IMAGE}" ;;
    run)
        local img=$IMAGE
        if [[ ${1:-} == -i || ${1:-} == --image ]]; then img=$2; shift 2; fi
        [[ ${1:-} == -- ]] && shift
        local args=(run --rm -it --device=/dev/kfd --ipc=host --security-opt seccomp=unconfined
            -v "$PWD:$PWD" -w "$PWD")
        # Só as GPUs escolhidas pelo numapilot; sem ele, todas.
        local renders=${NUMAPILOT_RENDER:-}
        if [[ -z $renders ]]; then renders=$(compgen -G '/dev/dri/renderD*' | tr '\n' ' ' || true); fi
        for r in $renders; do args+=(--device="$r"); done
        if [[ $eng == podman && $EUID -ne 0 ]]; then
            args+=(--group-add keep-groups)
            # Podman sem root herda a afinidade do numapilot (cpuset via cgroup costuma não estar delegado).
        else
            local gids
            mapfile -t gids < <(host_gid_args)
            args+=("${gids[@]}")
            [[ -n ${NUMAPILOT_CPUS:-} ]] && args+=(--cpuset-cpus "$NUMAPILOT_CPUS")
            [[ -n ${NUMAPILOT_MEMS:-} ]] && args+=(--cpuset-mems "$NUMAPILOT_MEMS")
        fi
        exec "$eng" "${args[@]}" "$img" "$@"
        ;;
    *) die "uso: gfx906-rocm container pull|run" ;;
    esac
}

# ---------------------------------------------------------------- laboratório
lab_cfg_dir() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/gfx906-lab"; }

lab_src() {
    local d self
    self=$(dirname "$(readlink -f "$0")")
    for d in "$LAB_SRC" "$self/../container" "$self/../share/numapilot/container"; do
        [[ -f $d/Containerfile ]] && { readlink -f "$d"; return; }
    done
    die "não achei o Containerfile do laboratório (LAB_SRC=$LAB_SRC)"
}

lab_latest_base() { # tag mais nova vX.Y.Z-rocm-A.B no Docker Hub
    curl -fsSL "https://hub.docker.com/v2/repositories/${LAB_BASE_REPO#docker.io/}/tags?page_size=100&ordering=last_updated" |
        python3 -c '
import json, re, sys
try:
    tags = [t["name"] for t in json.load(sys.stdin).get("results", [])]
except Exception:
    tags = []
ok = [t for t in tags if re.fullmatch(r"v[0-9.]+-rocm-[0-9.]+", t)]
key = lambda t: [int(x) for x in re.findall(r"[0-9]+", t)]
print(sorted(ok, key=key)[-1] if ok else "")'
}

lab_base() {
    if [[ -n $LAB_BASE ]]; then echo "$LAB_BASE"; return; fi
    if [[ $GPU_STACK != gfx906 ]]; then echo "$LAB_BASE_REPO:latest"; return; fi
    local t
    t=$(lab_latest_base) || true
    [[ -n $t ]] || die "não consegui consultar as tags de $LAB_BASE_REPO; defina LAB_BASE em $CONF"
    echo "$LAB_BASE_REPO:$t"
}

lab_image_base() { # base usada na imagem :latest atual
    "$(engine)" image inspect -f '{{ index .Config.Labels "io.numapilot.base" }}' "$LAB_IMAGE:latest" 2>/dev/null || true
}

lab_token() {
    local f
    f="$(lab_cfg_dir)/token"
    if [[ ! -s $f ]]; then
        mkdir -p "$(lab_cfg_dir)"
        (umask 077; head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' >"$f")
    fi
    cat "$f"
}

lab_keys() { # chaves públicas do usuário para o SSH do container
    local f
    f="$(lab_cfg_dir)/authorized_keys"
    mkdir -p "$(lab_cfg_dir)"
    cat "$HOME"/.ssh/*.pub "$HOME/.ssh/authorized_keys" 2>/dev/null | sort -u >"$f" || true
    chmod 600 "$f"
    echo "$f"
}

lab_build() {
    local base=${1:-} tag=${2:-latest}
    [[ -n $base ]] || base=$(lab_base)
    local eng src
    eng=$(engine)
    src=$(lab_src)
    if [[ $tag == latest ]] && "$eng" image inspect "$LAB_IMAGE:latest" >/dev/null 2>&1; then
        "$eng" tag "$LAB_IMAGE:latest" "$LAB_IMAGE:previous"
    fi
    info "construindo $LAB_IMAGE sobre $base (a primeira vez demora: a base tem vários GB)"
    local pull=(--pull)
    [[ $eng == podman ]] && pull=(--pull=newer)
    "$eng" pull "$base" >/dev/null 2>&1 || true
    local base_id
    base_id=$("$eng" image inspect -f '{{.Id}}' "$base" 2>/dev/null || true)
    "$eng" build "${pull[@]}" -f "$src/Containerfile" \
        --build-arg BASE="$base" --build-arg INSTALL_PYCHARM="$LAB_PYCHARM" --build-arg STACK="$GPU_STACK" \
        --label io.numapilot.base_id="$base_id" --label io.numapilot.stack="$GPU_STACK" \
        -t "$LAB_IMAGE:$tag" "$src"
}

lab_running() { [[ $("$(engine)" inspect -f '{{.State.Running}}' "$LAB_NAME" 2>/dev/null) == true ]]; }

lab_up() {
    local eng
    eng=$(engine)
    if lab_running; then lab_info; return; fi
    "$eng" rm -f "$LAB_NAME" >/dev/null 2>&1 || true
    "$eng" image inspect "$LAB_IMAGE:latest" >/dev/null 2>&1 || lab_build
    mkdir -p "$LAB_DIR" "$HOME/.cache/huggingface"
    local args=(run -d --name "$LAB_NAME" --hostname "$LAB_NAME" --restart unless-stopped
        --ipc=host --security-opt seccomp=unconfined
        -e LAB_TOKEN="$(lab_token)"
        -p "$LAB_BIND:$LAB_PORT_JUPYTER:8888" -p "$LAB_BIND:$LAB_PORT_CODE:8443" -p "$LAB_BIND:$LAB_PORT_SSH:2222"
        -v "$LAB_DIR:/workspace" -v "$LAB_NAME-home:/root"
        -v "$HOME/.cache/huggingface:/root/.cache/huggingface"
        -v "$(lab_keys):/lab/authorized_keys:ro")
    # GPUs: as escolhidas pelo numapilot (numapilot run --gpu ... -- gfx906-rocm lab up); senão todas.
    local renders=${NUMAPILOT_RENDER:-} r
    [[ -n $renders ]] || renders=$(compgen -G '/dev/dri/renderD*' | tr '\n' ' ' || true)
    for r in $renders; do args+=(--device="$r"); done
    mapfile -t -O "${#args[@]}" args < <(stack_devices)
    mapfile -t -O "${#args[@]}" args < <(stack_env)
    if [[ $eng == podman && $EUID -ne 0 ]]; then
        args+=(--group-add keep-groups)
    else
        local gids
        mapfile -t gids < <(host_gid_args)
        args+=("${gids[@]}")
        [[ -n ${NUMAPILOT_CPUS:-} ]] && args+=(--cpuset-cpus "$NUMAPILOT_CPUS")
        [[ -n ${NUMAPILOT_MEMS:-} ]] && args+=(--cpuset-mems "$NUMAPILOT_MEMS")
    fi
    # Tela (para abrir o PyCharm do container): X11/XWayland e Wayland.
    [[ -d /tmp/.X11-unix ]] && args+=(-v /tmp/.X11-unix:/tmp/.X11-unix:ro)
    [[ -n ${XAUTHORITY:-} && -f ${XAUTHORITY:-} ]] && args+=(-v "$XAUTHORITY:/lab/Xauthority:ro")
    if [[ -n ${XDG_RUNTIME_DIR:-} && -n ${WAYLAND_DISPLAY:-} && -S $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY ]]; then
        args+=(-v "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:/lab/wayland-0")
    fi
    "$eng" "${args[@]}" "$LAB_IMAGE:latest" >/dev/null
    enable_podman_restart
    sleep 3
    lab_info
}

lab_down() { "$(engine)" rm -f "$LAB_NAME" >/dev/null 2>&1 && info "laboratório parado"; }

lab_info() {
    local t host=$LAB_BIND
    [[ $host == 0.0.0.0 ]] && host=$(hostname)
    if ! lab_running; then echo "laboratório parado (gfx906-rocm lab up)"; return 1; fi
    t=$(lab_token)
    cat <<EOF
Laboratório rodando ($(lab_image_base))
  JupyterLab : http://$host:$LAB_PORT_JUPYTER/lab?token=$t
  VS Code    : http://$host:$LAB_PORT_CODE   (senha: $t)
  SSH        : ssh -p $LAB_PORT_SSH root@$host   (PyCharm/VS Code: interpretador /usr/bin/python3)
  Arquivos   : $LAB_DIR  ->  /workspace
EOF
}

lab_test() { "$(engine)" exec "$LAB_NAME" python3 /opt/lab/gpu-check.py; }

lab_update() {
    local check=0 force=0 a
    for a in "$@"; do
        case $a in --check) check=1 ;; --force) force=1 ;; esac
    done
    local cur new eng
    eng=$(engine)
    cur=$(lab_image_base)
    new=$(lab_base)
    echo "imagem atual: ${cur:-nenhuma}"
    echo "base nova   : $new"
    local ver=$new
    if [[ $GPU_STACK != gfx906 && $new == "$cur" && $force == 0 && $check == 0 ]]; then
        # Base com tag que anda (ex.: rocm/pytorch:latest): compara a build baixada com a usada.
        "$eng" pull "$new" >/dev/null 2>&1 || true
        local bid lid
        bid=$("$eng" image inspect -f '{{.Id}}' "$new" 2>/dev/null || true)
        lid=$("$eng" image inspect -f '{{ index .Config.Labels "io.numapilot.base_id" }}' "$LAB_IMAGE:latest" 2>/dev/null || true)
        if [[ -n $bid && $bid != "$lid" ]]; then
            ver="$new@${bid:0:12}"
            cur="$cur@${lid:0:12}"
            info "a base $new tem uma build nova"
            force=1
            if was_refused lab "$ver"; then
                info "esta build já foi testada e recusada antes"
                return 1
            fi
        fi
    fi
    if [[ $new == "$cur" && $force == 0 ]]; then
        info "a base já é a mais nova (use --force para reconstruir e atualizar os pacotes Python)"
        return 0
    fi
    [[ $check == 1 ]] && return 0
    if was_refused lab "$new" && [[ $force == 0 ]]; then
        info "esta versão já foi testada e recusada antes (use --force para testar de novo)"
        return 1
    fi
    # Constrói ao lado (:candidate) e valida antes de trocar: o laboratório atual continua rodando.
    lab_build "$new" candidate
    local rc=0
    run_validation lab "$LAB_IMAGE:candidate" || rc=$?
    if [[ $rc != 0 ]]; then
        local why=falhou
        [[ $rc == 2 ]] && why=lenta
        record_history lab "${cur:-nenhuma}" "$ver" "$why" "$VALID_METRICS"
        info "a versão nova não passou ($why): o laboratório continua em ${cur:-?}. Ela fica como $LAB_IMAGE:candidate para investigar."
        return 1
    fi
    "$eng" image inspect "$LAB_IMAGE:latest" >/dev/null 2>&1 && "$eng" tag "$LAB_IMAGE:latest" "$LAB_IMAGE:previous"
    "$eng" tag "$LAB_IMAGE:candidate" "$LAB_IMAGE:latest"
    "$eng" rmi "$LAB_IMAGE:candidate" >/dev/null 2>&1 || true
    save_baseline lab "$VALID_METRICS"
    record_history lab "${cur:-nenhuma}" "$ver" ok "$VALID_METRICS"
    if lab_running; then
        lab_down >/dev/null 2>&1 || true
        lab_up >/dev/null
    fi
    info "laboratório atualizado para $new"
}

lab_rollback() {
    local eng
    eng=$(engine)
    "$eng" image inspect "$LAB_IMAGE:previous" >/dev/null 2>&1 || die "não há imagem anterior"
    "$eng" tag "$LAB_IMAGE:previous" "$LAB_IMAGE:latest"
    lab_down >/dev/null 2>&1 || true
    lab_up
}

lab_pycharm() {
    local eng
    eng=$(engine)
    lab_running || die "suba o laboratório antes: gfx906-rocm lab up"
    "$eng" exec "$LAB_NAME" sh -c 'test -x /opt/pycharm/bin/pycharm || test -x /opt/pycharm/bin/pycharm.sh' ||
        die "a imagem não tem PyCharm: defina LAB_PYCHARM=1 em $CONF e rode gfx906-rocm lab build"
    local env=(-e DISPLAY="${DISPLAY:-:0}" -e XAUTHORITY=/lab/Xauthority)
    [[ -n ${WAYLAND_DISPLAY:-} ]] && env+=(-e XDG_RUNTIME_DIR=/lab -e WAYLAND_DISPLAY=wayland-0)
    # shellcheck disable=SC2016
    "$eng" exec -d "${env[@]}" "$LAB_NAME" sh -c 'exec "$(ls /opt/pycharm/bin/pycharm /opt/pycharm/bin/pycharm.sh 2>/dev/null | head -n1)"'
    info "PyCharm abrindo (interpretador: /usr/bin/python3 do container; projetos em /workspace)"
}

cmd_lab() {
    local sub=${1:-info}
    shift || true
    case $sub in
    build) lab_build "$@" ;;
    up | start) lab_up ;;
    down | stop) lab_down ;;
    restart) lab_down; lab_up ;;
    info | status) lab_info ;;
    shell) exec "$(engine)" exec -it "$LAB_NAME" bash ;;
    logs) exec "$(engine)" logs -f "$LAB_NAME" ;;
    test) lab_test ;;
    update) lab_update "$@" ;;
    rollback) lab_rollback ;;
    pycharm) lab_pycharm ;;
    *) die "uso: gfx906-rocm lab build|up|down|restart|info|shell|logs|test|update [--check|--force]|rollback|pycharm" ;;
    esac
}

# ---------------------------------------------------------------- servidor de IA
enable_podman_restart() { # containers com --restart voltam após reiniciar o PC (podman sem root)
    [[ $(engine) == podman && $EUID -ne 0 ]] && systemctl --user enable podman-restart.service >/dev/null 2>&1
    return 0
}

llm_latest_tag() {
    curl -fsSL "https://hub.docker.com/v2/repositories/${LLM_IMAGE_REPO#docker.io/}/tags?page_size=100&ordering=last_updated" |
        LLM_ROCM="$LLM_ROCM" python3 -c '
import json, os, re, sys
try:
    tags = [t["name"] for t in json.load(sys.stdin).get("results", [])]
except Exception:
    tags = []
want = os.environ.get("LLM_ROCM", "")
def info(t):
    m = re.fullmatch(r"(full-|server-)?b?(\d+)-rocm-([0-9.]+)", t)
    if not m: return None
    return (m.group(3) == want, m.group(1) == "full-", int(m.group(2)), [int(x) for x in m.group(3).split(".")])
c = [(info(t), t) for t in tags if info(t)]
print(max(c)[1] if c else "")'
}

llm_image() {
    if [[ -n $LLM_IMAGE ]]; then echo "$LLM_IMAGE"; return; fi
    if [[ $GPU_STACK != gfx906 ]]; then echo "$LLM_IMAGE_REPO:$(llm_moving_tag)"; return; fi
    local f t
    f="$(lab_cfg_dir)/llm.image"
    if [[ -s $f ]]; then cat "$f"; return; fi
    t=$(llm_latest_tag) || true
    [[ -n $t ]] || die "não consegui descobrir a imagem do llama.cpp; defina LLM_IMAGE"
    mkdir -p "$(lab_cfg_dir)"
    echo "$LLM_IMAGE_REPO:$t" | tee "$f"
}

llm_running() { [[ $("$(engine)" inspect -f '{{.State.Running}}' "$LLM_NAME" 2>/dev/null) == true ]]; }

llm_models() {
    [[ -d $LLM_MODELS ]] || { echo "(pasta $LLM_MODELS não existe)"; return 0; }
    find -L "$LLM_MODELS" -type f -name '*.gguf' ! -regex '.*-0000[2-9]-of-.*' ! -regex '.*-000[1-9][0-9]-of-.*' \
        -printf '%P\t%s\n' | sort | awk -F'\t' '{ printf "%s\t%.1f GB\n", $1, $2/1e9 }'
}

llm_health() {
    curl -fsS --max-time 3 "http://127.0.0.1:$LLM_PORT/health" 2>/dev/null | grep -q '"ok"'
}

llm_up() {
    local model=${1:-$LLM_MODEL}
    [[ -n $model ]] || die "escolha o modelo: gfx906-rocm llm up <arquivo.gguf> (veja gfx906-rocm llm models)"
    [[ -f $LLM_MODELS/$model ]] || die "modelo não encontrado: $LLM_MODELS/$model"
    if llm_running; then die "o servidor já está rodando (gfx906-rocm llm down antes)"; fi
    local img
    img=$(llm_image)
    "$(engine)" image inspect "$img" >/dev/null 2>&1 || "$(engine)" pull "$img"
    # Passa pelo numapilot para pegar só as GPUs escolhidas e os CPUs do socket delas.
    if command -v numapilot >/dev/null && [[ -z ${NUMAPILOT_MODE:-} ]]; then
        exec numapilot run --gpu "$LLM_GPU" --use compute --cpu gpu -- "$0" llm _run "$model" "$img"
    fi
    llm_run "$model" "$img"
}

llm_run() {
    local model=$1 img=$2 eng
    eng=$(engine)
    "$eng" rm -f "$LLM_NAME" >/dev/null 2>&1 || true
    local args=(run -d --name "$LLM_NAME" --restart unless-stopped --ipc=host
        --security-opt seccomp=unconfined -p "$LLM_BIND:$LLM_PORT:8080" -v "$LLM_MODELS:/models:ro"
        --label io.numapilot.model="$model" --entrypoint sh)
    local renders=${NUMAPILOT_RENDER:-} r ngpu=0
    [[ -n $renders ]] || renders=$(compgen -G '/dev/dri/renderD*' | tr '\n' ' ' || true)
    for r in $renders; do args+=(--device="$r"); ngpu=$((ngpu + 1)); done
    mapfile -t -O "${#args[@]}" args < <(stack_devices)
    if [[ $eng == podman && $EUID -ne 0 ]]; then
        args+=(--group-add keep-groups)
    else
        local gids
        mapfile -t gids < <(host_gid_args)
        args+=("${gids[@]}")
        [[ -n ${NUMAPILOT_CPUS:-} ]] && args+=(--cpuset-cpus "$NUMAPILOT_CPUS")
        [[ -n ${NUMAPILOT_MEMS:-} ]] && args+=(--cpuset-mems "$NUMAPILOT_MEMS")
    fi
    local srv=(-m "/models/$model" --host 0.0.0.0 --port 8080 -ngl 999 -c "$LLM_CTX" --jinja)
    local LLM_TUNED_ARGS="" LLM_TUNED_ONE=0 tf
    tf=$(tune_file "$model")
    # shellcheck source=/dev/null
    [[ -r $tf ]] && source "$tf" && info "usando o ajuste do otimizador: $LLM_TUNED_ARGS$( ((LLM_TUNED_ONE)) && echo ' (1 GPU)')"
    if ((LLM_TUNED_ONE)); then
        args+=(-e HIP_VISIBLE_DEVICES=0 -e CUDA_VISIBLE_DEVICES=0 -e GGML_VK_VISIBLE_DEVICES=0)
    elif [[ -z $LLM_TUNED_ARGS ]] && ((ngpu > 1)); then
        srv+=(--split-mode layer)
    fi
    # shellcheck disable=SC2206
    [[ -n $LLM_TUNED_ARGS ]] && srv+=($LLM_TUNED_ARGS)
    # shellcheck disable=SC2206
    [[ -n $LLM_ARGS ]] && srv+=($LLM_ARGS)
    # shellcheck disable=SC2016
    "$eng" "${args[@]}" "$img" -c 'exec "$(command -v llama-server || echo /app/llama-server)" "$@"' llama-server "${srv[@]}" >/dev/null
    enable_podman_restart
    info "carregando $model (pode levar alguns minutos)..."
    local i
    for i in $(seq 1 180); do
        if llm_health; then llm_info; return 0; fi
        llm_running || { "$eng" logs --tail 30 "$LLM_NAME"; die "o servidor parou ao carregar o modelo"; }
        sleep 2
    done
    info "ainda carregando; acompanhe com: gfx906-rocm llm logs"
}

llm_info() {
    if ! llm_running; then echo "servidor de IA parado (gfx906-rocm llm up <modelo>)"; return 1; fi
    local host=$LLM_BIND m
    [[ $host == 0.0.0.0 ]] && host=$(hostname)
    m=$("$(engine)" inspect -f '{{ index .Config.Labels "io.numapilot.model" }}' "$LLM_NAME" 2>/dev/null)
    cat <<EOF
Servidor de IA rodando: $m  ($(llm_health && echo pronto || echo carregando))
  Chat no navegador : http://$host:$LLM_PORT
  API (OpenAI)      : http://$host:$LLM_PORT/v1   (modelo: qualquer nome)
EOF
}

llm_update() {
    local check=0 a
    for a in "$@"; do [[ $a == --check ]] && check=1; done
    local cur new f
    f="$(lab_cfg_dir)/llm.image"
    cur=$(cat "$f" 2>/dev/null || true)
    if [[ -n $LLM_IMAGE ]]; then
        new=$LLM_IMAGE
    elif [[ $GPU_STACK != gfx906 ]]; then
        new="$LLM_IMAGE_REPO:$(llm_moving_tag)"
        [[ -n $cur ]] || cur=$new
    else
        new=$(llm_latest_tag) || true
        [[ -n $new ]] || die "não consegui consultar as builds do llama.cpp"
        new="$LLM_IMAGE_REPO:$new"
    fi
    echo "llama.cpp atual: ${cur:-nenhum}"
    echo "llama.cpp novo : $new"
    if [[ $GPU_STACK != gfx906 && $new == "$cur" ]]; then
        [[ $check == 1 ]] && { info "tag que anda ($new): a build nova é conferida ao atualizar"; return 0; }
        # Tag que anda: guarda a build atual, baixa a nova e compara.
        local eng old_id new_id
        eng=$(engine)
        old_id=$("$eng" image inspect -f '{{.Id}}' "$cur" 2>/dev/null || true)
        [[ -n $old_id ]] && "$eng" tag "$old_id" localhost/numapilot-llm:previous
        "$eng" pull "$new" >/dev/null || die "não consegui baixar $new"
        new_id=$("$eng" image inspect -f '{{.Id}}' "$new")
        if [[ $new_id == "$old_id" ]]; then info "já está na build mais nova"; return 0; fi
        local rc=0
        run_validation llm "$new" || rc=$?
        if [[ $rc != 0 ]]; then
            [[ -n $old_id ]] && "$eng" tag localhost/numapilot-llm:previous "$new"
            record_history llm "$new@${old_id:0:12}" "$new@${new_id:0:12}" "$([[ $rc == 2 ]] && echo lenta || echo falhou)" "$VALID_METRICS"
            info "a build nova não passou: voltei para a anterior"
            return 1
        fi
        mkdir -p "$(lab_cfg_dir)"
        echo "$new" >"$f"
        save_baseline llm "$VALID_METRICS"
        record_history llm "$new@${old_id:0:12}" "$new@${new_id:0:12}" ok "$VALID_METRICS"
        if llm_running; then
            local model
            model=$("$eng" inspect -f '{{ index .Config.Labels "io.numapilot.model" }}' "$LLM_NAME")
            "$eng" rm -f "$LLM_NAME" >/dev/null
            "$0" llm up "$model" || true
        fi
        info "llama.cpp atualizado"
        return 0
    fi
    [[ $new == "$cur" ]] && { info "já está na build mais nova"; return 0; }
    [[ $check == 1 ]] && return 0
    if was_refused llm "$new"; then
        info "esta build já foi testada e recusada antes; espera a próxima"
        return 1
    fi
    "$(engine)" pull "$new" || die "não consegui baixar $new"
    local rc=0
    run_validation llm "$new" || rc=$?
    if [[ $rc != 0 ]]; then
        local why=falhou
        [[ $rc == 2 ]] && why=lenta
        record_history llm "${cur:-nenhum}" "$new" "$why" "$VALID_METRICS"
        info "a build nova não passou ($why): continua ${cur:-a atual}"
        return 1
    fi
    mkdir -p "$(lab_cfg_dir)"
    [[ -n $cur ]] && echo "$cur" >"$(lab_cfg_dir)/llm.image.previous"
    echo "$new" >"$f"
    save_baseline llm "$VALID_METRICS"
    record_history llm "${cur:-nenhum}" "$new" ok "$VALID_METRICS"
    if llm_running; then
        local model
        model=$("$(engine)" inspect -f '{{ index .Config.Labels "io.numapilot.model" }}' "$LLM_NAME")
        "$(engine)" rm -f "$LLM_NAME" >/dev/null
        if ! (LLM_MODEL=$model "$0" llm up "$model"); then
            info "a build nova não subiu com $model: voltando para $cur"
            echo "$cur" >"$f"
            record_history llm "$new" "$cur" voltou null
            "$0" llm up "$model"
            return 1
        fi
    fi
    info "llama.cpp atualizado"
}

image_update() { # imagem ROCm base (tag fixa que recebe builds novas)
    local eng before after prev="localhost/gfx906-rocm-image:previous"
    eng=$(engine)
    before=$("$eng" image inspect -f '{{.Id}}' "$IMAGE" 2>/dev/null || true)
    [[ -n $before ]] && "$eng" tag "$IMAGE" "$prev"
    "$eng" pull "$IMAGE" >/dev/null || { info "não consegui baixar $IMAGE"; return 1; }
    after=$("$eng" image inspect -f '{{.Id}}' "$IMAGE")
    if [[ $before == "$after" ]]; then info "imagem ROCm já é a mais nova"; return 0; fi
    if run_validation image "$IMAGE"; then
        record_history image "${before:0:12}" "${after:0:12}" ok "$VALID_METRICS"
        info "imagem ROCm atualizada"
    else
        [[ -n $before ]] && "$eng" tag "$prev" "$IMAGE"
        record_history image "${before:0:12}" "${after:0:12}" falhou "$VALID_METRICS"
        info "a imagem nova falhou na validação: voltei para a anterior"
        return 1
    fi
}

cmd_llm() {
    local sub=${1:-info}
    shift || true
    case $sub in
    models) llm_models ;;
    up | start) llm_up "$@" ;;
    _run) llm_run "$@" ;;
    down | stop) "$(engine)" rm -f "$LLM_NAME" >/dev/null 2>&1 && info "servidor de IA parado" ;;
    info | status) llm_info ;;
    logs) exec "$(engine)" logs -f "$LLM_NAME" ;;
    update) llm_update "$@" ;;
    tune) llm_tune "$@" ;;
    *) die "uso: gfx906-rocm llm models|up [modelo.gguf]|down|info|logs|update [--check]|tune [modelo.gguf]" ;;
    esac
}

# ---------------------------------------------------------------- validação antes de trocar de versão
STATE_DIR="$(dirname "$UPDATE_LOG")"
RELEASES_URL="https://github.com/mixa3607/ML-gfx906/releases"

tune_file() { echo "$(lab_cfg_dir)/llm-tune/${1%.gguf}.env"; }

llm_tune() { # [modelo]: mede as combinações com o llama-bench e grava a mais rápida
    local model=${1:-$LLM_MODEL} img eng args ngpu=0 r out
    [[ -n $model ]] || die "diga o modelo: gfx906-rocm llm tune modelo.gguf (veja: gfx906-rocm llm models)"
    [[ -f $LLM_MODELS/$model ]] || die "modelo não encontrado: $LLM_MODELS/$model"
    if llm_running; then die "pare o servidor antes (gfx906-rocm llm down): o teste usa as mesmas GPUs"; fi
    eng=$(engine)
    img=$(llm_image)
    "$eng" image inspect "$img" >/dev/null 2>&1 || "$eng" pull "$img"
    mapfile -t args < <(gpu_args)
    mapfile -t -O "${#args[@]}" args < <(stack_env)
    for r in $(compgen -G '/dev/dri/renderD*' || true); do ngpu=$((ngpu + 1)); done
    [[ $GPU_STACK == cuda ]] && ngpu=$(nvidia-smi -L 2>/dev/null | wc -l || echo 1)
    [[ $GPU_STACK == gfx906 ]] && ngpu=$(expected_gpus)
    [[ -n ${LLM_TUNE_GPUS:-} ]] && ngpu=$LLM_TUNE_GPUS
    ((ngpu >= 1)) || ngpu=1
    local tmp
    tmp=$(mktemp -d)
    # combinações: nome | ambiente | argumentos do llama-bench | argumentos do llama-server
    local combos=() gsets=("all")
    ((ngpu > 1)) && gsets+=("one")
    local g fa
    for g in "${gsets[@]}"; do
        local sms=("none")
        [[ $g == all ]] && ((ngpu > 1)) && sms=("layer" "row")
        local sm
        for sm in "${sms[@]}"; do
            for fa in "0|f16" "1|f16" "1|q8_0"; do
                combos+=("$g|$sm|$fa")
            done
        done
    done
    info "otimizando $model: ${#combos[@]} combinações (prompt 512, geração 128, 2 rodadas cada)"
    local c i=0 best="" best_tg=0 best_pp=0
    : >"$tmp/res"
    for c in "${combos[@]}"; do
        i=$((i + 1))
        IFS='|' read -r g sm fa kv <<<"$c"
        local env=() bargs=(-ngl 999 -p 512 -n 128 -r 2 -o json -fa "$fa" -ctk "$kv" -ctv "$kv")
        [[ $g == one ]] && env=(-e HIP_VISIBLE_DEVICES=0 -e CUDA_VISIBLE_DEVICES=0 -e GGML_VK_VISIBLE_DEVICES=0)
        [[ $sm != none ]] && bargs+=(-sm "$sm")
        printf '  [%d/%d] %s GPU, divisão %s, flash attention %s, cache %s ... ' "$i" "${#combos[@]}" \
            "$([[ $g == one ]] && echo 1 || echo "$ngpu")" "$([[ $sm == none ]] && echo "—" || echo "$sm")" "$([[ $fa == 1 ]] && echo sim || echo não)" "$kv" >&2
        # shellcheck disable=SC2016
        if out=$("$eng" run --rm "${args[@]}" "${env[@]}" -v "$LLM_MODELS:/models:ro" --entrypoint sh "$img" -c \
            'b=$(command -v llama-bench || echo /app/llama-bench); m=$1; shift; exec "$b" -m "/models/$m" "$@"' sh "$model" "${bargs[@]}" 2>/dev/null); then
            local res
            res=$(python3 -c '
import json, sys
d = json.loads(sys.stdin.read())
pp = [r["avg_ts"] for r in d if r.get("n_prompt", 0) > 0 and r.get("n_gen", 0) == 0]
tg = [r["avg_ts"] for r in d if r.get("n_gen", 0) > 0 and r.get("n_prompt", 0) == 0]
print("%.1f %.1f" % (tg[0] if tg else 0, pp[0] if pp else 0))
' <<<"$out" 2>/dev/null || echo "0 0")
            local tg pp
            read -r tg pp <<<"$res"
            echo "gera $tg tok/s, prompt $pp tok/s" >&2
            echo "$c|$tg|$pp" >>"$tmp/res"
            # melhor = mais rápido para gerar; empate (até 2%) decide pelo prompt
            if python3 -c 'import sys; tg,pp,btg,bpp=map(float,sys.argv[1:]); sys.exit(0 if tg>btg*1.02 or (tg>=btg*0.98 and pp>bpp) else 1)' "$tg" "$pp" "$best_tg" "$best_pp"; then
                best=$c best_tg=$tg best_pp=$pp
            fi
        else
            echo "falhou (memória insuficiente ou combinação não suportada)" >&2
        fi
    done
    [[ -n $best ]] || { rm -rf "$tmp"; die "nenhuma combinação rodou"; }
    IFS='|' read -r g sm fa kv <<<"$best"
    local sargs="--flash-attn off"
    [[ $fa == 1 ]] && sargs="--flash-attn on"
    [[ $kv != f16 ]] && sargs+=" --cache-type-k $kv --cache-type-v $kv"
    [[ $sm != none ]] && sargs+=" --split-mode $sm"
    local f
    f=$(tune_file "$model")
    mkdir -p "$(dirname "$f")"
    {
        echo "# gfx906-rocm llm tune $(date -Iseconds) imagem $img"
        echo "# geração $best_tg tok/s, prompt $best_pp tok/s"
        echo "LLM_TUNED_ARGS=\"$sargs\""
        echo "LLM_TUNED_ONE=$([[ $g == one ]] && echo 1 || echo 0)"
    } >"$f"
    sort -t'|' -k5 -gr "$tmp/res" >"${f%.env}.results"
    rm -rf "$tmp"
    info "melhor: $([[ $g == one ]] && echo '1 GPU' || echo "$ngpu GPUs"), $sargs: $best_tg tok/s (prompt $best_pp)"
    info "gravado em $f; o próximo 'gfx906-rocm llm up $model' usa isto (apague o arquivo para voltar ao padrão)"
}

stack_env() { # variáveis extras por placa (uma linha cada)
    # BC-250: memória unificada; o llama.cpp com Vulkan gera texto 5-12% mais rápido na memória
    # visível pela CPU (heap 0) do que na "local" que ele escolhe sozinho.
    if [[ $GPU_STACK == vulkan ]] && grep -qil 0x13fe /sys/bus/pci/devices/*/device 2>/dev/null &&
        grep -qil 0x1002 /sys/bus/pci/devices/*/vendor 2>/dev/null; then
        printf '%s\n' -e GGML_VK_PREFER_HOST_MEMORY=1
    fi
    return 0
}

stack_devices() { # dispositivos extras da pilha (uma linha cada)
    case $GPU_STACK in
        gfx906 | rocm) [[ -e /dev/kfd ]] && echo --device=/dev/kfd ;;
        cuda) echo --device=nvidia.com/gpu=all ;; # CDI: nvidia-container-toolkit
    esac
    return 0
}

gpu_args() { # argumentos de GPU para um container de teste (uma linha cada)
    local r eng
    eng=$(engine)
    printf '%s\n' --ipc=host --security-opt seccomp=unconfined
    stack_devices
    for r in $(compgen -G '/dev/dri/renderD*' || true); do printf -- '--device=%s\n' "$r"; done
    if [[ $eng == podman && $EUID -ne 0 ]]; then
        printf '%s\n' --group-add keep-groups
    else
        host_gid_args
    fi
}

expected_gpus() { # quantas gfx906 o KFD enxerga
    local n=0 p
    for p in /sys/class/kfd/kfd/topology/nodes/*/properties; do
        [[ -r $p ]] && awk '/gfx_target_version/{exit !($2==90006)}' "$p" && n=$((n + 1))
    done
    echo "$n"
}

baseline_file() { echo "$STATE_DIR/baseline-$1.json"; }

# compara RESULT (json) com a referência da versão atual; sai 1 se ficou mais lenta que REGRESS_PCT
compare_baseline() {
    local comp=$1 result=$2
    BASE_FILE=$(baseline_file "$comp") REGRESS="$REGRESS_PCT" COMP="$comp" RESULT="$result" python3 - <<'PY'
import json, os, sys
comp, regress = os.environ["COMP"], float(os.environ["REGRESS"])
new = json.loads(os.environ["RESULT"])
try:
    old = json.load(open(os.environ["BASE_FILE"]))
except Exception:
    print("sem referência anterior: esta vira a referência"); sys.exit(0)
def pairs():
    if comp == "lab":
        for i, (a, b) in enumerate(zip(old.get("tflops", []), new.get("tflops", []))):
            yield f"GPU {i} fp16 TFLOPS", a, b
        if old.get("copy_gbs") and new.get("copy_gbs"):
            yield "cópia entre GPUs GB/s", old["copy_gbs"], new["copy_gbs"]
    elif comp == "llm" and old.get("model") == new.get("model"):
        for k, label in (("pp", "processar prompt tok/s"), ("tg", "gerar tok/s")):
            if old.get(k) and new.get(k):
                yield label, old[k], new[k]
bad = False
for label, a, b in pairs():
    pct = (b - a) / a * 100 if a else 0
    flag = ""
    if pct < -regress:
        flag, bad = "  <- mais lenta", True
    print(f"  {label}: {a:g} -> {b:g} ({pct:+.0f}%){flag}")
sys.exit(1 if bad else 0)
PY
}

save_baseline() { mkdir -p "$STATE_DIR"; printf '%s\n' "$2" >"$(baseline_file "$1")"; }

record_history() { # comp de para resultado metrics_json
