# valida o laboratório (PyTorch) numa imagem; imprime METRICS {json} no fim
validate_lab_image() {
    local img=$1 eng out src args
    eng=$(engine)
    src=$(lab_src)
    mapfile -t args < <(gpu_args)
    info "validando $img nas GPUs (correção, memória, desempenho)"
    out=$("$eng" run --rm "${args[@]}" -e VALIDATE_STACK="$GPU_STACK" -v "$src/gpu-validate.py:/tmp/gpu-validate.py:ro" --entrypoint python3 "$img" /tmp/gpu-validate.py 2>&1) || {
        echo "$out" | tail -n 15
        return 1
    }
    echo "$out" | grep -v '^RESULT ' | tail -n 8
    local result
    result=$(echo "$out" | sed -n 's/^RESULT //p' | tail -n1)
    python3 -c '
import json, sys
r = json.loads(sys.argv[1])
print("METRICS " + json.dumps({"tflops": [g.get("tflops_fp16", 0) for g in r["gpus"]], "copy_gbs": r.get("copy_gbs"), "gpus": len(r["gpus"]), "torch": r.get("torch")}))
' "$result"
}

bench_model() { # .gguf usado para medir o llama.cpp
    if [[ -n $LLM_BENCH_MODEL ]]; then echo "$LLM_BENCH_MODEL"; return; fi
    [[ -d $LLM_MODELS ]] || return 0
    find -L "$LLM_MODELS" -type f -name '*.gguf' ! -name '*-of-*' -printf '%s\t%P\n' 2>/dev/null | sort -n | head -n1 | cut -f2
}

validate_llm_image() {
    local img=$1 eng args model out
    eng=$(engine)
    mapfile -t args < <(gpu_args)
    model=$(bench_model)
    "$eng" image inspect "$img" >/dev/null 2>&1 || "$eng" pull "$img" >/dev/null || return 1
    if [[ -z $model ]]; then
        info "validando $img (sem modelo em $LLM_MODELS: só confere se enxerga as GPUs)"
        # shellcheck disable=SC2016
        out=$("$eng" run --rm "${args[@]}" --entrypoint sh "$img" -c \
            '$(command -v llama-server || echo /app/llama-server) --list-devices' 2>&1) || { echo "$out" | tail -n 10; return 1; }
        local n
        n=$(echo "$out" | grep -ci 'gfx906' || true)
        echo "$out" | grep -i 'rocm\|gfx' | head -n 4
        ((n >= 1)) || { echo "FALHOU: o llama.cpp não listou nenhuma gfx906"; return 1; }
        echo "METRICS {\"gpus\": $n}"
        return 0
    fi
    info "validando $img com $model (llama-bench)"
    # shellcheck disable=SC2016
    out=$("$eng" run --rm "${args[@]}" -v "$LLM_MODELS:/models:ro" --entrypoint sh "$img" -c \
        'b=$(command -v llama-bench || echo /app/llama-bench); exec "$b" -m "/models/$1" -ngl 999 -p 512 -n 128 -r 2 -o json' sh "$model" 2>/dev/null) || {
        echo "FALHOU: o llama-bench não rodou"
        return 1
    }
    MODEL="$model" python3 -c '
import json, os, sys
data = json.loads(sys.stdin.read())
pp = [r["avg_ts"] for r in data if r.get("n_prompt", 0) > 0 and r.get("n_gen", 0) == 0]
tg = [r["avg_ts"] for r in data if r.get("n_gen", 0) > 0 and r.get("n_prompt", 0) == 0]
m = {"model": os.environ["MODEL"], "pp": round(pp[0], 1) if pp else None, "tg": round(tg[0], 1) if tg else None}
print("  processar prompt: %s tok/s, gerar: %s tok/s" % (m["pp"], m["tg"]))
print("METRICS " + json.dumps(m))
' <<<"$out"
}

validate_rocm_image() {
    local img=$1 eng args out want t
    eng=$(engine)
    mapfile -t args < <(gpu_args)
    want=$(expected_gpus)
    info "validando $img (rocminfo e um kernel HIP em cada GPU)"
    t=$(mktemp -d)
    cat >"$t/t.hip" <<'HIP'
#include <hip/hip_runtime.h>
#include <cstdio>
__global__ void k(float* a){ int i=threadIdx.x; a[i]=i*2.0f; }
int main(){
  int n=0; if(hipGetDeviceCount(&n)!=hipSuccess||n==0){printf("nenhuma GPU HIP\n");return 1;}
  int bad=0;
  for(int d=0; d<n; d++){
    hipDeviceProp_t p; hipGetDeviceProperties(&p,d); hipSetDevice(d);
    float *g,h[64]; hipMalloc(&g,sizeof h); hipLaunchKernelGGL(k,1,64,0,0,g);
    hipMemcpy(h,g,sizeof h,hipMemcpyDeviceToHost); hipFree(g);
    int ok=1; for(int i=0;i<64;i++) if(h[i]!=i*2.0f) ok=0;
    printf("GPU %d %s: %s\n",d,p.gcnArchName,ok?"OK":"ERRO"); bad+=!ok;
  }
  return bad;
}
HIP
    # shellcheck disable=SC2016
    out=$("$eng" run --rm "${args[@]}" -v "$t:/t" --entrypoint sh "$img" -c \
        'rocminfo | grep -c "gfx906" ; hipcc --offload-arch=gfx906 -O1 /t/t.hip -o /t/t && /t/t' 2>&1) || {
        echo "$out" | tail -n 10
        rm -rf "$t"
        return 1
    }
    rm -rf "$t"
    echo "$out" | grep -E '^GPU ' || true
    local seen
    seen=$(echo "$out" | head -n1 | tr -dc '0-9')
    if [[ ${want:-0} -gt 0 && ${seen:-0} -lt 1 ]]; then echo "FALHOU: rocminfo não viu as gfx906"; return 1; fi
    echo "METRICS {\"gpus\": $(echo "$out" | grep -c '^GPU .*OK')}"
}

# valida e compara; uso: run_validation comp imagem  (imprime o resumo; METRICS fica em $VALID_METRICS)
VALID_METRICS=""
run_validation() {
    local comp=$1 img=$2 out
    case $comp in
    lab) out=$(validate_lab_image "$img") || { echo "$out"; return 1; } ;;
    llm) out=$(validate_llm_image "$img") || { echo "$out"; return 1; } ;;
    image) out=$(validate_rocm_image "$img") || { echo "$out"; return 1; } ;;
    esac
    echo "$out" | grep -v '^METRICS '
    VALID_METRICS=$(echo "$out" | sed -n 's/^METRICS //p' | tail -n1)
    [[ -n $VALID_METRICS ]] || VALID_METRICS=null
    if [[ $comp != image ]]; then
        compare_baseline "$comp" "$VALID_METRICS" || { echo "a versão nova ficou mais lenta que a atual (limite: $REGRESS_PCT%)"; return 2; }
    fi
    return 0
}

cmd_validate() { # valida as versões em uso agora e grava como referência
    local comp=${1:-all} rc=0 img
    for c in lab llm image; do
        [[ $comp == all || $comp == "$c" ]] || continue
        case $c in
        lab) "$(engine)" image inspect "$LAB_IMAGE:latest" >/dev/null 2>&1 || continue; img="$LAB_IMAGE:latest" ;;
        llm) img=$(cat "$(lab_cfg_dir)/llm.image" 2>/dev/null || true); [[ -n $img ]] || continue ;;
        image) "$(engine)" image inspect "$IMAGE" >/dev/null 2>&1 || continue; img=$IMAGE ;;
        esac
        echo "== $c ($img)"
        if run_validation "$c" "$img"; then
            [[ $c != image ]] && save_baseline "$c" "$VALID_METRICS"
            echo "OK (gravado como referência)"
        else
            rc=1
        fi
    done
    return $rc
}

