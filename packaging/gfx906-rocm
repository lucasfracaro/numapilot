cmd_doctor() {
    echo "kernel: $(uname -r)"
    if lsmod 2>/dev/null | grep -q '^amdgpu'; then echo "amdgpu: carregado"; else echo "amdgpu: NÃO carregado"; fi
    if [[ -e /dev/kfd ]]; then
        echo "/dev/kfd: $(stat -c '%A %G' /dev/kfd)"
        [[ -r /dev/kfd && -w /dev/kfd ]] || echo "  → sem acesso: sudo usermod -aG render,video $USER (e saia/entre na sessão)"
    else
        echo "/dev/kfd: ausente (driver amdgpu sem KFD?)"
    fi
    echo "grupos: $(id -nG)"
    local n=0
    for p in /sys/class/kfd/kfd/topology/nodes/*/properties; do
        local v
        v=$(awk '/gfx_target_version/{print $2}' "$p")
        [[ $v == 90006 ]] && n=$((n + 1))
    done
    echo "GPUs gfx906 no KFD: $n"
    command -v numapilot >/dev/null && numapilot topo | sed -n '/^GPUs/,$p'
    if command -v pacman >/dev/null; then
        local sys
        sys=$(pacman -Qq 2>/dev/null | grep -E '^(rocm-|hip-runtime|rocblas|miopen)' | tr '\n' ' ' || true)
        [[ -n $sys ]] && echo "ROCm do sistema (pacman): $sys
  → pode conviver; só não misture LD_LIBRARY_PATH dos dois no mesmo programa."
    fi
    echo "versão ativa: $(readlink "$ROCM_BASE/current" 2>/dev/null || echo nenhuma)"
    echo "pilha de computação: $GPU_STACK (GPU_STACK em $CONF; auto detecta)"
    echo "  laboratório: $LAB_BASE_REPO   servidor de IA: $LLM_IMAGE_REPO"
    [[ $GPU_STACK == cuda ]] && ! [[ -e /etc/cdi/nvidia.yaml || -e /var/run/cdi/nvidia.yaml ]] &&
        echo "  NVIDIA em container: sudo pacman -S nvidia-container-toolkit && sudo nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml"
}

main() {
    local c=${1:-help}; shift || true
    case $c in
    list | ls) cmd_list ;;
    install) cmd_install "$@" ;;
    use) cmd_use "$@" ;;
    rollback) cmd_rollback ;;
    test) cmd_test "$@" ;;
    update) cmd_update "$@" ;;
    prune) cmd_prune "$@" ;;
    remove | rm) cmd_remove "$@" ;;
    env) cmd_env "$@" ;;
    exec) cmd_exec "$@" ;;
    container) cmd_container "$@" ;;
    lab) cmd_lab "$@" ;;
    llm) cmd_llm "$@" ;;
    auto-update | update-all) auto_update ;;
    check) cmd_check ;;
    validate) cmd_validate "$@" ;;
    hold) cmd_hold "${1:-}" 1 ;;
    unhold) cmd_hold "${1:-}" 0 ;;
    history) cmd_history ;;
    autoupdate) autoupdate_cmd "$@" ;;
    doctor) cmd_doctor ;;
    help | -h | --help) usage ;;
    *) usage; exit 1 ;;
    esac
}
main "$@"
