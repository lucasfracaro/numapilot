# ---------------------------------------------------------------- atualização automática
auto_update() {
    mkdir -p "$STATE_DIR"
    local ok=1 summary=() eng
    eng=$(engine)
    {
        echo "=== $(date '+%F %T') (modo: $UPDATE_MODE) ==="
        cmd_check
        if [[ $UPDATE_MODE == aviso ]]; then
            if grep -q '"any":true' "$STATE_DIR/available.json" 2>/dev/null; then summary+=("há versões novas: abra o numapilot para atualizar"); fi
        else
            if "$eng" image inspect "$LAB_IMAGE:latest" >/dev/null 2>&1; then
                if is_held lab; then summary+=("laboratório travado")
                elif (lab_update); then summary+=("laboratório OK")
                else summary+=("laboratório: versão nova recusada (mantida a atual)"); ok=0; fi
            fi
            if [[ -s "$(lab_cfg_dir)/llm.image" ]]; then
                if is_held llm; then summary+=("llama.cpp travado")
                elif (llm_update); then summary+=("llama.cpp OK")
                else summary+=("llama.cpp: build nova recusada (mantida a atual)"); ok=0; fi
            fi
            if "$eng" image inspect "$IMAGE" >/dev/null 2>&1; then
                if is_held image; then summary+=("imagem ROCm travada")
                elif (image_update); then summary+=("imagem ROCm OK")
                else summary+=("imagem ROCm: build nova recusada"); ok=0; fi
            fi
            if [[ -L $ROCM_BASE/current ]] && ! is_held rocm; then
                if (cmd_update); then summary+=("ROCm nativo OK"); else summary+=("ROCm nativo: versão nova recusada"); ok=0; fi
            fi
        fi
        [[ ${#summary[@]} -gt 0 ]] || summary+=("tudo em dia")
        echo "resultado: ${summary[*]}"
    } > >(tee -a "$UPDATE_LOG") 2>&1
    printf '{"time":"%s","ok":%s,"summary":"%s"}\n' "$(date -Iseconds)" "$([[ $ok == 1 ]] && echo true || echo false)" \
        "$(IFS=';'; echo "${summary[*]}")" >"$STATE_DIR/last-update.json"
    command -v notify-send >/dev/null && notify-send -a numapilot "Atualização das MI50" "$(IFS=$'\n'; echo "${summary[*]}")" || true
    [[ $ok == 1 ]]
}

