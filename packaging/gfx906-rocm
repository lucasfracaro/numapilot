hub_digest() { # digest de uma tag no Docker Hub
    local repo=${1%:*} tag=${1##*:}
    repo=${repo#docker.io/}
    curl -fsSL "https://hub.docker.com/v2/repositories/$repo/tags/$tag" 2>/dev/null |
        python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("digest",""))
except Exception: print("")'
}

# Procura versões novas sem mudar nada. Grava available.json para a interface.
cmd_check() {
    local eng lines=() any=0 cur new
    eng=$(engine)
    mkdir -p "$STATE_DIR"
    if "$eng" image inspect "$LAB_IMAGE:latest" >/dev/null 2>&1; then
        cur=$(lab_image_base); new=$(lab_base 2>/dev/null || true)
        if [[ -n $new && $new != "$cur" ]]; then any=1; fi
        lines+=("$(printf '"lab":{"current":"%s","new":"%s","held":%s}' "$cur" "${new:-?}" "$(is_held lab && echo true || echo false)")")
        echo "laboratório: ${cur:-?}  ->  ${new:-sem informação}$( [[ -n $new && $new != "$cur" ]] && echo '  (NOVA)')$(is_held lab && echo '  [travado]')"
    fi
    cur=$(cat "$(lab_cfg_dir)/llm.image" 2>/dev/null || true)
    if [[ -n $cur ]]; then
        new=$(llm_latest_tag 2>/dev/null || true)
        [[ -n $new ]] && new="$LLM_IMAGE_REPO:$new"
        [[ -n $LLM_IMAGE ]] && new=$LLM_IMAGE
        if [[ -n $new && $new != "$cur" ]]; then any=1; fi
        lines+=("$(printf '"llm":{"current":"%s","new":"%s","held":%s}' "${cur##*:}" "${new##*:}" "$(is_held llm && echo true || echo false)")")
        echo "llama.cpp  : ${cur##*:}  ->  ${new##*:}$( [[ -n $new && $new != "$cur" ]] && echo '  (NOVA)')$(is_held llm && echo '  [travado]')"
    fi
    if "$eng" image inspect "$IMAGE" >/dev/null 2>&1; then
        local ld rd
        ld=$("$eng" image inspect -f '{{.Digest}}' "$IMAGE" 2>/dev/null || true)
        rd=$(hub_digest "$IMAGE")
        local upd=false
        [[ -n $rd && $rd != "$ld" ]] && { upd=true; any=1; }
        lines+=("$(printf '"image":{"current":"%s","new":"%s","held":%s}' "${IMAGE##*:}" "$($upd && echo "${IMAGE##*:} (nova build)" || echo "${IMAGE##*:}")" "$(is_held image && echo true || echo false)")")
        echo "imagem ROCm: ${IMAGE##*:}$($upd && echo '  (NOVA build)')$(is_held image && echo '  [travado]')"
    fi
    if [[ -L $ROCM_BASE/current ]]; then
        cur=$(readlink "$ROCM_BASE/current"); new=$(latest_remote 2>/dev/null | sed -E 's#.*/##; s/\.tar\.(gz|xz)$//' || true)
        if [[ -n $new && $new != "$cur" ]]; then any=1; fi
        lines+=("$(printf '"rocm":{"current":"%s","new":"%s","held":%s}' "$cur" "${new:-?}" "$(is_held rocm && echo true || echo false)")")
        echo "ROCm nativo: $cur  ->  ${new:-sem informação}"
    fi
    printf '{"time":"%s","stack":"%s","any":%s,"releases":"%s",%s}\n' "$(date -Iseconds)" "$GPU_STACK" "$([[ $any == 1 ]] && echo true || echo false)" \
        "$RELEASES_URL" "$(IFS=,; echo "${lines[*]:-\"_\":null}")" >"$STATE_DIR/available.json"
    [[ $any == 1 ]] && echo "Novidades da comunidade: $RELEASES_URL"
    return 0
}

