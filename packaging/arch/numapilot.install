# shellcheck shell=bash
post_install() {
  echo ">> Enable the service:   sudo systemctl enable --now numapilot"
  echo ">> Graphical interface:  numapilot (in the menu) or numapilot-gui"
  echo ">> Lab/AI:               sudo pacman -S podman  and then  gfx906-rocm lab up"
  echo ">> Check everything:     numapilot doctor"
  echo ">> Phone panel:          systemctl --user enable --now numapilot-web  (link: numapilot web --url)"
}
post_upgrade() {
  systemctl daemon-reload >/dev/null 2>&1
  systemctl try-restart numapilot.service >/dev/null 2>&1
  return 0
}
pre_remove() {
  systemctl disable --now numapilot.service >/dev/null 2>&1
  return 0
}
